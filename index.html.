<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Blockazon MC — 1.21.11 Marketplace</title>
<style>
:root{--nav:#0b1220;--nav2:#162338;--gold:#ffd43b;--blue:#38bdf8;--bg:#eef2f7;--card:#fff;--text:#142033;--muted:#718096;--line:#dfe6ee;--green:#22c55e}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Arial}
button,input,select{font:inherit}.top{position:sticky;top:0;z-index:30;background:linear-gradient(110deg,#09111f,#172840);color:#fff;padding:13px 3vw;display:flex;align-items:center;gap:15px;box-shadow:0 4px 20px #0003}.logo{font-size:25px;font-weight:950;white-space:nowrap}.logo b{color:var(--blue)}.logo i{color:var(--gold);font-style:normal}.search{display:flex;flex:1;max-width:850px}.search input{flex:1;border:0;padding:12px 14px;border-radius:9px 0 0 9px;outline:0}.search button{border:0;background:var(--gold);padding:0 17px;border-radius:0 9px 9px 0;cursor:pointer}.top button{cursor:pointer}.tb{background:#ffffff10;color:white;border:1px solid #ffffff20;padding:10px 12px;border-radius:9px}.nav{background:var(--nav2);color:#dce9f7;padding:9px 3vw;display:flex;gap:22px;overflow:auto}.nav span{white-space:nowrap;cursor:pointer}.hero{max-width:1500px;margin:auto;padding:48px 5vw;min-height:270px;color:#fff;background:radial-gradient(circle at 85% 30%,#38bdf833,transparent 27%),linear-gradient(135deg,#14233a,#1e405b)}.hero h1{font-size:clamp(32px,5vw,57px);line-height:1;margin:0 0 14px}.hero p{max-width:700px;color:#dcecff;font-size:18px}.hero .btn,.primary{border:0;background:var(--gold);padding:12px 19px;border-radius:9px;font-weight:900;cursor:pointer}.wrap{max-width:1500px;margin:auto;padding:25px 3vw}.bar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}.bar select,.bar input{padding:10px;border:1px solid var(--line);background:#fff;border-radius:8px}.count{margin-left:auto;color:var(--muted);font-size:14px}.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:15px}.card{background:#fff;border:1px solid var(--line);border-radius:13px;padding:11px;box-shadow:0 4px 16px #12233a0a;min-width:0}.pic{height:155px;border-radius:9px;background:linear-gradient(145deg,#e9f6ff,#dce6f2);display:grid;place-items:center}.pic img{width:105px;height:105px;image-rendering:pixelated;object-fit:contain}.fallback{font-size:60px}.card h3{font-size:15px;margin:12px 2px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.id{font-size:10px;color:#8a96a5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.price{font-size:20px;font-weight:950;margin:9px 2px}.buy{width:100%;padding:9px;border:0;background:#ffe36b;border-radius:8px;font-weight:850;cursor:pointer}.buy:hover{background:var(--gold)}.drawer,.modal{display:none;position:fixed;inset:0;background:#07101dcc;z-index:60}.drawer.open,.modal.open{display:block}.drawerbox{position:absolute;right:0;top:0;height:100%;width:min(470px,100%);background:#fff;padding:23px;overflow:auto}.modalbox{width:min(650px,calc(100% - 26px));max-height:88vh;overflow:auto;background:#fff;margin:6vh auto;border-radius:16px;padding:24px}.close{float:right;border:0;background:#edf1f6;padding:7px 10px;border-radius:8px;cursor:pointer}.cartrow{display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--line);padding:12px 0}.mini{width:45px;height:45px;background:#eef7ff;border-radius:8px;display:grid;place-items:center}.mini img{width:35px;height:35px;image-rendering:pixelated}.qty{display:flex;gap:6px;align-items:center}.qty button{border:1px solid var(--line);background:white;border-radius:5px}.field{margin:13px 0}.field label{display:block;font-weight:800;margin-bottom:6px}.field input{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:8px}.order{border:1px solid var(--line);border-radius:10px;padding:13px;margin:9px 0}.adminGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.stat{padding:15px;background:#f6f9fc;border-radius:10px}.notice{position:fixed;right:18px;bottom:18px;background:#132033;color:white;padding:13px 17px;border-radius:10px;z-index:100;display:none}.empty{text-align:center;padding:35px;color:var(--muted)}footer{background:#0d1624;color:#9fb0c0;text-align:center;padding:32px;margin-top:25px}
@media(max-width:720px){.top{flex-wrap:wrap}.search{order:3;flex-basis:100%}.count{margin-left:0}.adminGrid{grid-template-columns:1fr}}@media(max-width:480px){.products{grid-template-columns:repeat(2,minmax(0,1fr))}.pic{height:125px}.pic img{width:78px;height:78px}.card{padding:8px}}
</style>
</head>
<body>
<header class="top">
<div class="logo">Block<b>azon</b><i>MC</i></div>
<div class="search"><input id="q" placeholder="Block suchen, z. B. Diamant, Holz, Glas …"><button onclick="search()">🔎</button></div>
<button class="tb" onclick="openCart()">🛒 <span id="cc">0</span></button>
<button class="tb" onclick="openAdmin()">👑 Admin</button>
</header>
<nav class="nav">
<span onclick="setCat('Alle')">☰ Alle</span><span onclick="setCat('Baumaterial')">🧱 Baumaterial</span><span onclick="setCat('Holz')">🌳 Holz</span><span onclick="setCat('Erze')">💎 Erze</span><span onclick="setCat('Deko')">🏠 Deko</span><span onclick="setCat('Redstone')">⚙️ Redstone</span><span onclick="setCat('Natur')">🌿 Natur</span>
</nav>
<section class="hero"><h1>Der Minecraft-Marktplatz.</h1><p>Blockazon ist dein Shop für Minecraft Java 1.21.11. Durchsuche den großen Block-Katalog und bezahle mit 💎 Diamanten.</p><button class="btn" onclick="document.getElementById('shop').scrollIntoView({behavior:'smooth'})">Shop öffnen →</button></section>

<main class="wrap" id="shop">
<div class="bar"><select id="cat" onchange="setCat(this.value)"><option>Alle</option><option>Baumaterial</option><option>Holz</option><option>Erze</option><option>Deko</option><option>Redstone</option><option>Natur</option></select><select id="sort" onchange="render()"><option value="name">Name A–Z</option><option value="price">Preis niedrig → hoch</option><option value="priceDesc">Preis hoch → niedrig</option></select><span class="count" id="status">Lade 1.21.11-Katalog …</span></div>
<div class="products" id="products"></div>
</main>

<div class="drawer" id="cart"><div class="drawerbox"><button class="close" onclick="closeCart()">✕</button><h2>Warenkorb</h2><div id="cartItems"></div><div id="cartBottom"></div></div></div>
<div class="modal" id="checkout"><div class="modalbox"><button class="close" onclick="closeCheckout()">✕</button><h2>Bestellung abschließen</h2><p style="color:#718096">Dein Minecraft-Name wird mit der Bestellung gespeichert.</p><div class="field"><label>Minecraft-Name *</label><input id="mc" maxlength="32" placeholder="Steve123"></div><div class="field"><label>Notiz (optional)</label><input id="note" maxlength="140" placeholder="z. B. bitte am Spawn"></div><div id="summary"></div><button class="primary" style="width:100%;margin-top:10px" onclick="order()">💎 Bestellung absenden</button></div></div>
<div class="modal" id="admin"><div class="modalbox"><button class="close" onclick="closeAdmin()">✕</button><h2>👑 Besitzerbereich</h2><div id="login"></div><div id="panel" style="display:none"><div class="adminGrid"><div class="stat"><b>Bestellungen</b><div id="statOrders">0</div></div><div class="stat"><b>Artikel im Katalog</b><div id="statProducts">0</div></div></div><h3>Bestellungen</h3><div id="orders"></div><button onclick="logout()" style="margin-top:8px">Abmelden</button></div></div></div>
<div class="notice" id="notice"></div>
<footer>Blockazon MC · Minecraft Java 1.21.11 · Demo-Shop</footer>

<script>
const RAW="https://gist.githubusercontent.com/SynkMC/bd7e2d85bac06f0de16ae3c069a1558b/raw/f8f416085e945163dff4f90a8369153516bac1a5/blocks.json";
const ASSET="https://mcasset.cloud/1.21.11/assets/minecraft/textures/block/";
const excluded=new Set(["AIR","CAVE_AIR","VOID_AIR","BARRIER","BEDROCK","END_GATEWAY","END_PORTAL","END_PORTAL_FRAME","COMMAND_BLOCK","CHAIN_COMMAND_BLOCK","REPEATING_COMMAND_BLOCK","JIGSAW","STRUCTURE_BLOCK","STRUCTURE_VOID","LIGHT","PISTON_HEAD","MOVING_PISTON","FIRE","SOUL_FIRE","BUBBLE_COLUMN","FROSTED_ICE","FARMLAND","PLAYER_HEAD","PLAYER_WALL_HEAD"]);
const technical=/^(ATTACHED_|.*_STEM$|.*_PLANT$|.*_WALL_(BANNER|SIGN|HANGING_SIGN)$|.*_WALL_FAN$|.*_HEAD$|.*_CAKE$|.*_PORTAL$|.*_GATEWAY$)/;
let products=[],cat="Alle",cart=JSON.parse(localStorage.getItem("bz3cart")||"[]");
const pretty=s=>s.toLowerCase().split("_").map(x=>x.charAt(0).toUpperCase()+x.slice(1)).join(" ");
function category(id){if(/_(PLANKS|LOG|WOOD|STEM|HYPHAE|NYLIUM|MOSAIC|FENCE|DOOR|TRAPDOOR|STAIRS|SLAB|BUTTON|SIGN|SHELF)$/.test(id)||/^(OAK|SPRUCE|BIRCH|JUNGLE|ACACIA|DARK_OAK|MANGROVE|CHERRY|PALE_OAK|BAMBOO|CRIMSON|WARPED)_/.test(id))return"Holz";if(/(ORE|BLOCK$)|^(ANCIENT_DEBRIS|RAW_)/.test(id))return"Erze";if(/(TORCH|LAMP|LANTERN|CARPET|BANNER|BED$|POT|HEAD|CANDLE|GLASS|SHULKER|BOOKSHELF|FLOWER|CORAL|PAINTING)/.test(id))return"Deko";if(/(PISTON|REDSTONE|HOPPER|DROPPER|DISPENSER|COMPARATOR|REPEATER|OBSERVER|CRAFTER|LEVER|PRESSURE_PLATE|TRIPWIRE|RAIL)/.test(id))return"Redstone";if(/(GRASS|FERN|FLOWER|LEAVES|SAPLING|MUSHROOM|VINE|BUSH|KELP|SEAGRASS|LILY|CACTUS|BAMBOO)/.test(id))return"Natur";return"Baumaterial"}
function price(id){if(/DIAMOND|NETHERITE|ANCIENT_DEBRIS/.test(id))return 12;if(/EMERALD|GOLD/.test(id))return 8;if(/IRON|COPPER/.test(id))return 5;if(/DEEPSLATE|BLACKSTONE|QUARTZ/.test(id))return 3;if(/STONE|COBBLE|DIRT|SAND|GRAVEL|CLAY/.test(id))return 1;if(/WOOD|PLANKS|LOG|LEAVES/.test(id))return 2;return 2}
function img(id){let x=id.toLowerCase();return ASSET+x+".png"}
async function load(){
 try{let r=await fetch(RAW);let ids=await r.json();products=ids.filter(id=>!excluded.has(id)&&!technical.test(id)&&id!=="AIR").map((id,i)=>({id,n:pretty(id),p:price(id),c:category(id),i:i}));}
 catch(e){products=fallback.map((id,i)=>({id,n:pretty(id),p:price(id),c:category(id),i}));}
 document.getElementById("status").textContent=products.length+" reguläre Katalogeinträge · Version 1.21.11";
 render();updateCount()
}
const fallback=["STONE","GRANITE","POLISHED_GRANITE","DIORITE","ANDESITE","COBBLESTONE","DEEPSLATE","COBBLED_DEEPSLATE","DIRT","GRASS_BLOCK","SAND","RED_SAND","GRAVEL","CLAY","BRICKS","STONE_BRICKS","OAK_LOG","OAK_PLANKS","OAK_SLAB","OAK_STAIRS","SPRUCE_LOG","SPRUCE_PLANKS","BIRCH_LOG","BIRCH_PLANKS","JUNGLE_LOG","JUNGLE_PLANKS","ACACIA_LOG","ACACIA_PLANKS","DARK_OAK_LOG","DARK_OAK_PLANKS","MANGROVE_LOG","MANGROVE_PLANKS","CHERRY_LOG","CHERRY_PLANKS","PALE_OAK_LOG","PALE_OAK_PLANKS","BAMBOO_BLOCK","BAMBOO_PLANKS","GLASS","GLASS_PANE","GOLD_BLOCK","IRON_BLOCK","COPPER_BLOCK","DIAMOND_BLOCK","EMERALD_BLOCK","COAL_BLOCK","LAPIS_BLOCK","REDSTONE_BLOCK","OBSIDIAN","CRYING_OBSIDIAN","NETHERRACK","NETHER_BRICKS","END_STONE","QUARTZ_BLOCK","AMETHYST_BLOCK","GLOWSTONE","SEA_LANTERN","PRISMARINE","PRISMARINE_BRICKS","DARK_PRISMARINE","MOSS_BLOCK","MOSSY_COBBLESTONE","TNT","CRAFTING_TABLE","FURNACE","CHEST","BARREL","BEACON","ENCHANTING_TABLE","ANVIL","LANTERN","CAMPFIRE"];
function filtered(){let q=document.getElementById("q").value.toLowerCase();let a=products.filter(x=>(cat==="Alle"||x.c===cat)&&(x.n.toLowerCase().includes(q)||x.id.toLowerCase().includes(q)));let s=document.getElementById("sort").value;return a.sort((a,b)=>s==="price"?a.p-b.p:s==="priceDesc"?b.p-a.p:a.n.localeCompare(b.n,"de"))}
function render(){document.getElementById("products").innerHTML=filtered().map(x=>`<article class="card"><div class="pic"><img src="${img(x.id)}" alt="${x.n}" onerror="this.style.display='none';this.parentElement.innerHTML='<span class=fallback>🧱</span>'"></div><h3 title="${x.n}">${x.n}</h3><div class="id">minecraft:${x.id.toLowerCase()}</div><div class="price">${x.p} 💎</div><button class="buy" onclick="add('${x.id}')">In den Warenkorb</button></article>`).join("")||'<div class="empty">Nichts gefunden.</div>'}
function setCat(c){cat=c;document.getElementById("cat").value=c;render()}
function search(){render()}
function add(id){let x=cart.find(a=>a.id===id);x?x.q++:cart.push({id,q:1});save();updateCount();show("Zum Warenkorb hinzugefügt ✓")}
function save(){localStorage.setItem("bz3cart",JSON.stringify(cart))}
function updateCount(){document.getElementById("cc").textContent=cart.reduce((s,x)=>s+x.q,0)}
function total(){return cart.reduce((s,x)=>s+(products.find(p=>p.id===x.id)?.p||0)*x.q,0)}
function openCart(){renderCart();document.getElementById("cart").classList.add("open")}
function closeCart(){document.getElementById("cart").classList.remove("open")}
function renderCart(){let b=document.getElementById("cartItems");if(!cart.length){b.innerHTML='<div class=empty>Warenkorb leer.</div>';document.getElementById("cartBottom").innerHTML="";return}b.innerHTML=cart.map(a=>{let p=products.find(x=>x.id===a.id);return `<div class=cartrow><div class=mini><img src="${img(a.id)}" onerror="this.style.display='none'"></div><div style="flex:1"><b>${p?.n||pretty(a.id)}</b><div class=qty><button onclick="change('${a.id}',-1)">−</button>${a.q}<button onclick="change('${a.id}',1)">+</button></div></div><b>${(p?.p||0)*a.q} 💎</b></div>`}).join("");document.getElementById("cartBottom").innerHTML=`<h3>Gesamt: ${total()} 💎</h3><button class=primary style="width:100%" onclick="checkoutStart()">Zur Kasse →</button>`}
function change(id,d){let a=cart.find(x=>x.id===id);a.q+=d;if(a.q<1)cart=cart.filter(x=>x.id!==id);save();updateCount();renderCart()}
function checkoutStart(){closeCart();document.getElementById("summary").innerHTML=`<div class=stat>${cart.reduce((s,x)=>s+x.q,0)} Artikel · <b>${total()} 💎</b></div>`;document.getElementById("checkout").classList.add("open")}
function closeCheckout(){document.getElementById("checkout").classList.remove("open")}
function order(){let name=document.getElementById("mc").value.trim();if(!name)return alert("Bitte Minecraft-Namen eingeben.");let o=JSON.parse(localStorage.getItem("bz3orders")||"[]");o.unshift({id:"BZ-"+Date.now().toString().slice(-7),name,items:cart.map(x=>({...x})),total:total(),note:document.getElementById("note").value.trim(),time:new Date().toLocaleString("de-DE")});localStorage.setItem("bz3orders",JSON.stringify(o));cart=[];save();updateCount();closeCheckout();show("Bestellung gesendet ✓");document.getElementById("mc").value=""}
function openAdmin(){document.getElementById("admin").classList.add("open");let logged=localStorage.getItem("bz3owner")==="yes";document.getElementById("login").innerHTML=logged?"":'<p>Nur der Besitzer darf diesen Bereich öffnen.</p><div class=field><label>Besitzer-Passwort</label><input id=pass type=password placeholder="Dein Passwort"></div><button class=primary onclick="login()">Einloggen</button>';document.getElementById("panel").style.display=logged?"block":"none";if(logged)renderOrders()}
function login(){/* Für echte Sicherheit muss das Passwort serverseitig geprüft werden. Demo-Passwort hier bewusst nicht geheim. */if(document.getElementById("pass").value==="BLOCKAZON-OWNER"){localStorage.setItem("bz3owner","yes");openAdmin()}else alert("Falsches Passwort.")}
function logout(){localStorage.removeItem("bz3owner");openAdmin()}
function closeAdmin(){document.getElementById("admin").classList.remove("open")}
function renderOrders(){let o=JSON.parse(localStorage.getItem("bz3orders")||"[]");document.getElementById("statOrders").textContent=o.length;document.getElementById("statProducts").textContent=products.length;document.getElementById("orders").innerHTML=o.length?o.map(x=>`<div class=order><b>${x.id}</b> · ${x.time}<br>👤 <b>${esc(x.name)}</b><br>${x.items.map(a=>a.q+"× "+pretty(a.id)).join(" · ")}<br><b>${x.total} 💎</b>${x.note?`<br><span style=color:#718096>Notiz: ${esc(x.note)}</span>`:""}</div>`).join(""):'<div class=empty>Noch keine Bestellungen.</div>'}
function esc(s){return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function show(t){let n=document.getElementById("notice");n.textContent=t;n.style.display="block";setTimeout(()=>n.style.display="none",2200)}
document.getElementById("q").addEventListener("input",render);load();
</script>
</body></html>
